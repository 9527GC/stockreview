# Normalize line endings to LF across the repository.
# This avoids Windows `core.autocrlf` warnings and keeps shell scripts working in Linux containers.
* text=auto eol=lf

# Treat binary files as binary so Git never converts their line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
