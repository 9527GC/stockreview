page { background: #f5f8fc; }
.page { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 48rpx 36rpx; box-sizing: border-box; overflow: hidden; }
.background-orb { position: absolute; border-radius: 50%; pointer-events: none; }
.orb-one { width: 460rpx; height: 460rpx; top: -180rpx; right: -170rpx; background: #d9f7e8; opacity: .7; }
.orb-two { width: 360rpx; height: 360rpx; bottom: -190rpx; left: -170rpx; background: #e4efff; opacity: .8; }
.card { position: relative; z-index: 1; width: 100%; padding: 56rpx 40rpx 42rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.9); border-radius: 32rpx; background: rgba(255,255,255,.96); text-align: center; box-shadow: 0 24rpx 70rpx rgba(30, 67, 114, .12); }
.brand-mark { width: 88rpx; height: 88rpx; margin: 0 auto 24rpx; padding: 6rpx; box-sizing: border-box; border-radius: 28rpx; background: #dff8e9; }
.brand-icon { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 23rpx; background: #07c160; color: #fff; font-size: 42rpx; font-weight: 600; }
.eyebrow { margin-bottom: 12rpx; color: #07a651; font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; }
.title { color: #182230; font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.message { margin: 6rpx auto 0; max-width: 560rpx; color: #7b8798; font-size: 27rpx; line-height: 1.65; }
.steps { display: flex; align-items: center; justify-content: center; margin: 42rpx 0 36rpx; }
.step { display: flex; flex-direction: column; align-items: center; color: #9aa6b5; font-size: 21rpx; white-space: nowrap; }
.step.active { color: #344054; }
.step-dot { width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx; border-radius: 50%; background: #edf1f5; color: #9aa6b5; font-size: 21rpx; }
.step.active .step-dot { background: #07c160; color: #fff; box-shadow: 0 6rpx 14rpx rgba(7,193,96,.2); }
.step-line { width: 68rpx; height: 2rpx; margin: -28rpx 12rpx 0; background: #dfe5eb; }
.profile-form { margin-top: 34rpx; }
.avatar-picker { position: relative; width: 164rpx; height: 164rpx; padding: 0; margin: 0 auto 34rpx; border: 0; background: transparent; line-height: 1; }
.avatar-picker::after { border: 0; }
.avatar { display: block; width: 164rpx; height: 164rpx; margin: 0 auto; border: 6rpx solid #fff; border-radius: 50%; background: #edf5ff; box-sizing: border-box; box-shadow: 0 10rpx 28rpx rgba(38,76,112,.12); }
.avatar-placeholder { width: 164rpx; height: 164rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border: 4rpx dashed #a8dfbe; border-radius: 50%; background: #f0fbf4; color: #16a05a; font-size: 23rpx; }
.camera-icon { display: block; margin-bottom: 4rpx; font-size: 45rpx; font-weight: 200; line-height: 1; }
.avatar-edit { position: absolute; right: -8rpx; bottom: -8rpx; padding: 8rpx 16rpx; border: 4rpx solid #fff; border-radius: 22rpx; background: #07c160; color: #fff; font-size: 20rpx; }
.field-label { margin-bottom: 12rpx; color: #344054; font-size: 25rpx; font-weight: 600; text-align: left; }
.input-wrap { display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #e1e7ee; border-radius: 16rpx; background: #fbfcfe; transition: border-color .2s; }
.input-icon { margin-right: 18rpx; color: #b2bdc9; font-size: 16rpx; }
.nickname-input { flex: 1; height: 88rpx; color: #273142; font-size: 28rpx; text-align: left; }
.action { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; padding: 0 28rpx; margin-top: 28rpx; border: 0; border-radius: 16rpx; background: linear-gradient(135deg, #10c86a, #07a957); color: #fff; font-size: 29rpx; font-weight: 600; box-shadow: 0 12rpx 24rpx rgba(7,169,87,.22); }
.action::after { border: 0; }
.action-arrow { margin-left: 18rpx; font-size: 36rpx; font-weight: 300; }
.privacy-note { margin-top: 26rpx; color: #a3adb9; font-size: 20rpx; }
.lock-icon { color: #9ba8b5; font-size: 24rpx; }
.account-name { margin-bottom: 18rpx; color: #344054; font-size: 30rpx; font-weight: 500; }

