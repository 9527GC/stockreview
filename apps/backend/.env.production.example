# MongoDB - 生产环境数据库（请替换真实密码）（前后端服务和数据在同一个服务器）
MONGODB_URI=mongodb://<USER>:<PASSWORD>@<ALIYUN_MONGODB_HOST>:27017/stock_review_prod?authSource=admin

# 端口
PORT=3000

# JWT 密钥（生产环境使用独立密钥）
JWT_SECRET=<GENERATE_A_STRONG_UNIQUE_PRODUCTION_SECRET>

# 其他配置
ENABLE_PROFIT_HISTORY_SCHEDULER=true
ENABLE_MARKET_SNAPSHOT_SCHEDULER=true

# CORS 白名单（生产环境必须设置为实际前端域名，多个用逗号分隔）
CORS_ORIGINS=https://stock.gc9527.com

# 全局限流（15 分钟内最大请求数）
RATE_LIMIT_MAX=200

# 行情接口限流（15 分钟内最大请求数）
RATE_LIMIT_MARKET_MAX=60

# Tushare Pro API Token（请替换为真实 Token）
TUSHARE_TOKEN=<YOUR_TUSHARE_TOKEN>

# 微信小程序配置（Web 扫码进入小程序绑定微信）
WECHAT_MINIAPP_APP_ID=<YOUR_WECHAT_MINIAPP_APP_ID>
WECHAT_MINIAPP_APP_SECRET=<YOUR_WECHAT_MINIAPP_APP_SECRET>
WECHAT_MINIAPP_BIND_PAGE=pages/wechat-bind/index
WECHAT_MINIAPP_BIND_EXPIRES=300
WECHAT_MINIAPP_ENV_VERSION=release
