# MongoDB - 生产环境数据库（请替换真实密码）
MONGODB_URI=mongodb://root:<PROD_MONGODB_PASSWORD>@stockreview-prod-mongodb.ns-rojp4s9y.svc:27017/stock_review_prod?authSource=admin

# 端口
PORT=3000

# JWT 密钥（生产环境使用独立密钥）
JWT_SECRET=stock-review-prod-secret-key-2024

# 其他配置
ENABLE_PROFIT_HISTORY_SCHEDULER=true
ENABLE_MARKET_SNAPSHOT_SCHEDULER=true

# CORS 白名单（生产环境必须设置为实际前端域名，多个用逗号分隔）
CORS_ORIGINS=https://static-host-rojp4s9y-stockreview.sealosbja.site,https://stock.gc9527.com

# 全局限流（15 分钟内最大请求数）
RATE_LIMIT_MAX=200

# 行情接口限流（15 分钟内最大请求数）
RATE_LIMIT_MARKET_MAX=60

# Tushare Pro API Token（请替换为真实 Token）
TUSHARE_TOKEN=<YOUR_TUSHARE_TOKEN>
