# 测试环境：使用独立数据库，绝不能指向生产库
MONGODB_URI=mongodb://<USER>:<PASSWORD>@127.0.0.1:27017/stockreview_staging?authSource=admin
PORT=3001
JWT_SECRET=<USE_A_DIFFERENT_SECRET_FROM_PRODUCTION>
ENABLE_PROFIT_HISTORY_SCHEDULER=false
ENABLE_MARKET_SNAPSHOT_SCHEDULER=false
CORS_ORIGINS=https://test-stock.gc9527.com
RATE_LIMIT_MAX=500
RATE_LIMIT_MARKET_MAX=120
TUSHARE_TOKEN=<YOUR_TUSHARE_TOKEN>
WECHAT_MINIAPP_APP_ID=<YOUR_WECHAT_MINIAPP_APP_ID>
WECHAT_MINIAPP_APP_SECRET=<YOUR_WECHAT_MINIAPP_APP_SECRET>
WECHAT_CALLBACK_URL=https://test-stock.gc9527.com/api/users/wechat/callback
FRONTEND_PROFILE_URL=https://test-stock.gc9527.com/#/pages/user/profile
WECHAT_MINIAPP_BIND_PAGE=pages/wechat-bind/index
WECHAT_MINIAPP_BIND_EXPIRES=300
WECHAT_MINIAPP_ENV_VERSION=trial
